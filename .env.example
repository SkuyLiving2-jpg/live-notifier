DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxx/xxxxx

# Opsional - tiap berapa detik bot ngecek API IDN buat live baru. Default 20
# kalau nggak diisi. Makin kecil = makin cepet kedetek live barunya, tapi
# makin sering nembak API IDN - jangan diset kekecilan banget.
POLL_INTERVAL_SECONDS=20

# Opsional - ID user Discord yang mau di-mention khusus buat notif prioritas
# (Nala/Levi/Lily). Cara dapetinnya: aktifin Developer Mode di Discord
# Settings > Advanced, terus klik kanan nama kamu sendiri > Copy User ID.
PRIORITY_PING_USER_ID=

# Opsional - token bot Discord (BEDA dari webhook di atas) buat fitur
# tanya-jawab interaktif ("cok, ini yang masih live siapa aja?"). Dapetin
# dari Discord Developer Portal > Applications > Bot > Reset Token.
DISCORD_BOT_TOKEN=

# Opsional - ID channel Discord tempat bot boleh lebih "agresif" balas
# (hampir semua pesan yang gak dikenali dibalas menu options, gak perlu
# nyebut "cok"/"live" dulu). Channel lain tetap butuh wake word. Cara
# dapetin ID channel: Developer Mode di Discord Settings > Advanced, terus
# klik kanan nama channel-nya > Copy Channel ID.
BOT_CHANNEL_ID=

# Opsional - ambang durasi (menit) buat alert "kemungkinan mendekati akhir"
# kalau belum ada riwayat durasi buat member itu. Default 40 kalau nggak diisi.
ENDING_SOON_THRESHOLD_MINUTES=40

# Opsional - secret buat lindungin endpoint API kayak /api/status pake
# signature (HMAC-SHA256 + timestamp), biar nggak bisa diakses sembarangan
# orang. Generate secret acak yang panjang, JANGAN dipake nilai contoh ini:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Nilai yang SAMA PERSIS ini juga dipake scripts/cek-top-gifter.js buat
# nge-sign request pas ngirim hasil cek gifter ke bot (lihat BOT_API_URL).
API_SECRET=

# Opsional - CUMA dipake script CLI manual di scripts/ (bukan bot utamanya:
# cek-top-gifter.js buat ngirim hasil cek top-gifter, backup-data.js buat
# narik backup, backfill-live-history.js buat isi celah histori live dari
# chat Discord, repair-live-history.js buat beresin sesi durasinya korup dari
# backfill versi lama, set-channel-routing.js buat push pemetaan channel
# khusus per-member). Isi URL publik bot kamu di Railway, misal
# https://nama-project-kamu.up.railway.app - kalau dikosongin, cek-top-gifter.js
# tetap jalan normal (cuma hasilnya keliatan di layar doang), tapi
# backup-data.js/backfill-live-history.js/repair-live-history.js/
# set-channel-routing.js butuh ini wajib diisi.
BOT_API_URL=

# Opsional - jam berapa (WIB, 0-23) rekap harian dikirim tiap hari. Default
# 23 (jam 11 malam) kalau nggak diisi.
DAILY_RECAP_HOUR=23
